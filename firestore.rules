rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A player's document is named after their anonymous uid: anyone may
    // read it (names and looks are public by design), only they may write.
    match /rcfPlayers/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'look', 'tone', 'found', 'hidden', 'updatedAt'])
        && request.resource.data.get('look', '').size() <= 1200
        && request.resource.data.get('name', '').size() <= 24;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
